<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background search -->
    <solid android:color="@color/app_surface"/>

    <!-- Garis / border -->
    <stroke
        android:width="2dp"
        android:color="@color/primary_orange"/>

    <!-- Sudut membulat -->
    <corners android:radius="12dp"/>

    <!-- Padding dalam -->
    <padding
        android:left="12dp"
        android:right="12dp"
        android:top="8dp"
        android:bottom="8dp"/>
</shape>